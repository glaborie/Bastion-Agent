# =============================================================================
# Bastion-Agent Makefile
# -----------------------------------------------------------------------------
# Targets are grouped by area. Run `make help` for the full list.
# =============================================================================

SHELL := /bin/bash
COMPOSE := docker compose -f docker-compose.yml -f docker-compose.vault.yml
VAULT_CMD := docker compose -f docker-compose.vault.yml run --rm vault
VAULT_ADDR := https://127.0.0.1:8200
VAULT_TOKEN := dev-root-token-bastion
# The vault CLI lives in the vault image, not on the host.
VAULT_CLI := $(COMPOSE) exec -T -e VAULT_SKIP_VERIFY=true vault vault

.PHONY: help
help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"; printf "Usage: make [target]\n\n"} /^[a-zA-Z0-9_-]+:.*?##/ { printf "  %-22s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

# ---- Vault (secrets management) ---------------------------------------------
.PHONY: vault-up
vault-up: vault/certs/vault.crt ## Start Vault, unseal it, seed dev secrets on first run
	$(COMPOSE) up -d --build vault
	$(COMPOSE) up --build vault-bootstrap

# Self-signed dev cert; vault/certs/ is gitignored, so it is generated per host.
vault/certs/vault.crt:
	@mkdir -p vault/certs
	openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj "/CN=vault" \
	  -addext "subjectAltName=DNS:vault,DNS:localhost,IP:127.0.0.1" \
	  -keyout vault/certs/vault.key -out vault/certs/vault.crt 2>/dev/null
	@chmod 600 vault/certs/vault.key
	@echo "[vault-certs] wrote vault/certs/vault.{crt,key}"

.PHONY: vault-down
vault-down: ## Stop and remove Vault containers (data volume persists)
	$(COMPOSE) down vault vault-bootstrap

.PHONY: vault-shell
vault-shell: ## Open an interactive Vault shell
	$(VAULT_CMD) sh

.PHONY: vault-export
vault-export: ## Materialise infra creds from Vault into a gitignored .env.vault
	@echo "[vault-export] writing .env.vault from Vault ..."
	@printf '%s\n' \
	  '# Auto-generated by `make vault-export`. NEVER commit this file.' \
	  '# Infra credentials materialised from Vault at deploy time.' \
	  '# App secrets (JWT signing, HMAC, DLP master key, OAuth client secret,' \
	  '# API keys) are read from Vault at runtime and never appear here.' \
	  "POSTGRES_PASSWORD=$$($(VAULT_CLI) kv get -field=POSTGRES_PASSWORD bastion/db/postgres)" \
	  "REDIS_PASSWORD=$$($(VAULT_CLI) kv get -field=REDIS_PASSWORD bastion/db/redis)" \
	  "KEYCLOAK_ADMIN_PASSWORD=$$($(VAULT_CLI) kv get -field=KEYCLOAK_ADMIN_PASSWORD bastion/db/keycloak)" \
	  "MINIO_ROOT_PASSWORD=$$($(VAULT_CLI) kv get -field=MINIO_ROOT_PASSWORD bastion/db/minio)" \
	  "KEYCLOAK_CLIENT_SECRET=$$($(VAULT_CLI) kv get -field=KEYCLOAK_CLIENT_SECRET bastion/db/keycloak)" \
	  > .env.vault
	@chmod 600 .env.vault
	@! grep -qE '^[A-Za-z_]+=$$' .env.vault || { rm -f .env.vault; \
	  echo "[vault-export] FAILED: empty secret value (is Vault up and seeded? make vault-up)"; exit 1; }
	@echo "[vault-export] done. .env.vault is gitignored."

.PHONY: vault-list
vault-list: ## List all secrets in Vault (paths only, no values)
	@$(VAULT_CLI) kv list -format=json bastion/ | python3 -c "import sys,json; d=json.load(sys.stdin); print('\n'.join(d['data']['keys'] if isinstance(d,dict) else d))"

.PHONY: vault-rotate
vault-rotate: ## Rotate a secret: make vault-rotate SECRET=db/postgres
	@$(VAULT_CLI) kv patch bastion/$(SECRET) value=$$(python3 -c "import os; print(os.urandom(24).hex())")
	@echo "Rotated bastion/$(SECRET). Re-run \`make vault-export\` for infra creds."

# ---- Stack lifecycle --------------------------------------------------------
.PHONY: up
up: ## Start the full stack (requires Vault)
	$(COMPOSE) up -d

.PHONY: down
down: ## Stop the full stack
	$(COMPOSE) down

.PHONY: logs
logs: ## Tail logs for all services
	$(COMPOSE) logs -f