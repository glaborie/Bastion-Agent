# =============================================================================
# Bastion-Agent Makefile
# -----------------------------------------------------------------------------
# Targets are grouped by area. Run `make help` for the full list.
# =============================================================================

SHELL := /bin/bash
# `.env.vault` (from `make vault-export`) wins over the hand-typed `.env` for the
# keys it carries: a later --env-file takes precedence, and the app services load
# it as a second env_file in docker-compose.yml. Without the file the render is
# exactly the pre-IDEA-056 one, so a fresh clone and CI are unaffected.
COMPOSE_ENV := --env-file .env$(if $(wildcard .env.vault), --env-file .env.vault,)
COMPOSE := docker compose $(COMPOSE_ENV) -f docker-compose.yml -f docker-compose.vault.yml
VAULT_CMD := docker compose -f docker-compose.vault.yml run --rm vault
VAULT_ADDR := https://127.0.0.1:8200
VAULT_TOKEN := dev-root-token-bastion
# The vault CLI lives in the vault image, not on the host.
VAULT_CLI := $(COMPOSE) exec -T -e VAULT_SKIP_VERIFY=true vault vault
# A non-secret value from .env, read without sourcing the file; the fallback
# keeps a missing line from producing a malformed host URL.
env_value = $(or $(shell sed -n 's/^$(1)=//p' .env 2>/dev/null | head -1),$(2))

.PHONY: help
help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"; printf "Usage: make [target]\n\n"} /^[a-zA-Z0-9_-]+:.*?##/ { printf "  %-22s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

# ---- Vault (secrets management) ---------------------------------------------
.PHONY: vault-up
vault-up: vault/certs/vault.crt ## Start Vault, unseal it, seed dev secrets on first run
	$(COMPOSE) up -d --build vault
	$(COMPOSE) up --build vault-bootstrap

# Self-signed dev cert; vault/certs/ is gitignored, so it is generated per host.
vault/certs/vault.crt:
	@mkdir -p vault/certs
	openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj "/CN=vault" \
	  -addext "subjectAltName=DNS:vault,DNS:localhost,IP:127.0.0.1" \
	  -keyout vault/certs/vault.key -out vault/certs/vault.crt 2>/dev/null
	@chmod 600 vault/certs/vault.key
	@echo "[vault-certs] wrote vault/certs/vault.{crt,key}"

.PHONY: vault-down
vault-down: ## Stop and remove Vault containers (data volume persists)
	$(COMPOSE) down vault vault-bootstrap

.PHONY: vault-shell
vault-shell: ## Open an interactive Vault shell
	$(VAULT_CMD) sh

.PHONY: vault-export
vault-export: ## Materialise every Vault credential into a gitignored .env.vault
	@echo "[vault-export] writing .env.vault from Vault ..."
	@printf '%s\n' \
	  '# Auto-generated by `make vault-export`. NEVER commit this file.' \
	  '# Infra credentials and application secrets materialised from Vault.' \
	  '# Plaintext at mode 600: read by every process on this host (ADR-021).' \
	  "POSTGRES_PASSWORD=$$($(VAULT_CLI) kv get -field=POSTGRES_PASSWORD bastion/db/postgres)" \
	  "POSTGRES_APP_USER=$$($(VAULT_CLI) kv get -field=POSTGRES_APP_USER bastion/db/postgres)" \
	  "POSTGRES_APP_PASSWORD=$$($(VAULT_CLI) kv get -field=POSTGRES_APP_PASSWORD bastion/db/postgres)" \
	  "REDIS_PASSWORD=$$($(VAULT_CLI) kv get -field=REDIS_PASSWORD bastion/db/redis)" \
	  "KEYCLOAK_ADMIN_PASSWORD=$$($(VAULT_CLI) kv get -field=KEYCLOAK_ADMIN_PASSWORD bastion/db/keycloak)" \
	  "MINIO_ROOT_PASSWORD=$$($(VAULT_CLI) kv get -field=MINIO_ROOT_PASSWORD bastion/db/minio)" \
	  "KEYCLOAK_CLIENT_SECRET=$$($(VAULT_CLI) kv get -field=KEYCLOAK_CLIENT_SECRET bastion/db/keycloak)" \
	  "VAULT_MASTER_KEY=$$($(VAULT_CLI) kv get -field=VAULT_MASTER_KEY bastion/app/dlp)" \
	  "PAYLOAD_ESCROW_MASTER_KEY=$$($(VAULT_CLI) kv get -field=PAYLOAD_ESCROW_MASTER_KEY bastion/app/dlp)" \
	  "APPROVAL_HMAC_SECRET=$$($(VAULT_CLI) kv get -field=APPROVAL_HMAC_SECRET bastion/app/jwt)" \
	  "JOB_SIGNING_SECRET=$$($(VAULT_CLI) kv get -field=JOB_SIGNING_SECRET bastion/app/jwt)" \
	  "AUDIT_WITNESS_ACCESS_KEY=$$($(VAULT_CLI) kv get -field=AUDIT_WITNESS_ACCESS_KEY bastion/db/minio)" \
	  "AUDIT_WITNESS_SECRET_KEY=$$($(VAULT_CLI) kv get -field=AUDIT_WITNESS_SECRET_KEY bastion/db/minio)" \
	  "AUDIT_WITNESS_HMAC_SECRET=$$($(VAULT_CLI) kv get -field=AUDIT_WITNESS_HMAC_SECRET bastion/app/audit)" \
	  "OMNIROUTE_API_KEY=$$($(VAULT_CLI) kv get -field=OMNIROUTE_API_KEY bastion/app/oauth)" \
	  "OMNIROUTE_ADMIN_PASSWORD=$$($(VAULT_CLI) kv get -field=OMNIROUTE_ADMIN_PASSWORD bastion/db/omniroute)" \
	  "PGADMIN_DEFAULT_PASSWORD=$$($(VAULT_CLI) kv get -field=PGADMIN_DEFAULT_PASSWORD bastion/db/pgadmin)" \
	  "HF_TOKEN=$$($(VAULT_CLI) kv get -field=HF_TOKEN bastion/app/models)" \
	  "OPENROUTER_API_KEY=$$($(VAULT_CLI) kv get -field=OPENROUTER_API_KEY bastion/app/oauth)" \
	  "LLAMA_API_KEY=$$($(VAULT_CLI) kv get -field=LLAMA_API_KEY bastion/app/oauth)" \
	  "LANGFUSE_SECRET_KEY=$$($(VAULT_CLI) kv get -field=LANGFUSE_SECRET_KEY bastion/app/observability)" \
	  "ARIZE_API_KEY=$$($(VAULT_CLI) kv get -field=ARIZE_API_KEY bastion/app/observability)" \
	  "OPIK_API_KEY=$$($(VAULT_CLI) kv get -field=OPIK_API_KEY bastion/app/observability)" \
	  "DATABASE_URL=postgresql+asyncpg://$(call env_value,POSTGRES_USER,bastion):$$($(VAULT_CLI) kv get -field=POSTGRES_PASSWORD bastion/db/postgres)@localhost:$(call env_value,POSTGRES_PORT,5432)/$(call env_value,POSTGRES_DB,bastion)" \
	  "REDIS_URL=redis://:$$($(VAULT_CLI) kv get -field=REDIS_PASSWORD bastion/db/redis)@localhost:$(call env_value,REDIS_PORT,6379)/0" \
	  > .env.vault
	@chmod 600 .env.vault
	@! grep -qE '^(POSTGRES_PASSWORD|POSTGRES_APP_PASSWORD|REDIS_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLIENT_SECRET|MINIO_ROOT_PASSWORD|VAULT_MASTER_KEY|PAYLOAD_ESCROW_MASTER_KEY|APPROVAL_HMAC_SECRET|JOB_SIGNING_SECRET|AUDIT_WITNESS_ACCESS_KEY|AUDIT_WITNESS_SECRET_KEY|AUDIT_WITNESS_HMAC_SECRET|OMNIROUTE_API_KEY|OMNIROUTE_ADMIN_PASSWORD|PGADMIN_DEFAULT_PASSWORD)=$$' .env.vault || { rm -f .env.vault; \
	  echo "[vault-export] FAILED: empty secret value (make vault-up && make vault-import, then retry)"; exit 1; }
	@echo "[vault-export] done. .env.vault is gitignored."

# `kv patch` merges: two keys share `app/oauth` and `app/observability`, and a
# plain `kv put` for the second would replace the first. The fallback creates a
# path that does not exist yet (`app/models`, first run). Surrounding quotes are
# stripped, so Vault holds what the dotenv loader would have read.
.PHONY: vault-import
vault-import: ## Copy the externally-issued secrets from .env into Vault once
	@set -eu; \
	for pair in \
	  "OPENROUTER_API_KEY=bastion/app/oauth" \
	  "LLAMA_API_KEY=bastion/app/oauth" \
	  "HF_TOKEN=bastion/app/models" \
	  "LANGFUSE_SECRET_KEY=bastion/app/observability" \
	  "ARIZE_API_KEY=bastion/app/observability" \
	  "OPIK_API_KEY=bastion/app/observability"; do \
	  key=$${pair%%=*}; path=$${pair#*=}; \
	  value=$$(sed -n "s/^$$key=//p" .env | head -1); \
	  case "$$value" in \
	    \"*\") value=$${value#\"}; value=$${value%\"} ;; \
	    \'*\') value=$${value#\'}; value=$${value%\'} ;; \
	  esac; \
	  $(VAULT_CLI) kv patch "$$path" "$$key=$$value" >/dev/null 2>&1 || \
	    $(VAULT_CLI) kv put "$$path" "$$key=$$value" >/dev/null; \
	done; \
	echo "[vault-import] imported the externally-issued keys (empty when unset); no value printed."


.PHONY: vault-check
vault-check: ## Fail if .env.vault is incomplete or has drifted from Vault
	uv run python scripts/check_env_vault.py --vault

.PHONY: vault-list
vault-list: ## List all secrets in Vault (paths only, no values)
	@$(VAULT_CLI) kv list -format=json bastion/ | python3 -c "import sys,json; d=json.load(sys.stdin); print('\n'.join(d['data']['keys'] if isinstance(d,dict) else d))"

.PHONY: vault-rotate
vault-rotate: ## Rotate a secret: make vault-rotate SECRET=db/postgres [FIELD=POSTGRES_PASSWORD]
	@set -eu; \
	field="$(FIELD)"; \
	if [ -z "$$field" ]; then \
	  case "$(SECRET)" in \
	    db/postgres) field=POSTGRES_PASSWORD ;; \
	    db/redis) field=REDIS_PASSWORD ;; \
	    db/keycloak) field=KEYCLOAK_ADMIN_PASSWORD ;; \
	    db/minio) field=AUDIT_WITNESS_SECRET_KEY ;; \
	    db/pgadmin) field=PGADMIN_DEFAULT_PASSWORD ;; \
	    db/omniroute) field=OMNIROUTE_ADMIN_PASSWORD ;; \
	    app/oauth) field=OMNIROUTE_API_KEY ;; \
	    app/audit) field=AUDIT_WITNESS_HMAC_SECRET ;; \
	    app/dlp) field=VAULT_MASTER_KEY ;; \
	    *) echo "[vault-rotate] name the field: make vault-rotate SECRET=$(SECRET) FIELD=<name>" >&2; exit 2 ;; \
	  esac; \
	fi; \
	value=$$(python3 -c 'import base64, os, sys; print(base64.b64encode(os.urandom(32)).decode() if sys.argv[1].endswith("MASTER_KEY") else os.urandom(32).hex())' "$$field"); \
	$(VAULT_CLI) kv patch "bastion/$(SECRET)" "$$field=$$value" >/dev/null; \
	echo "[vault-rotate] rotated $(SECRET) field $$field; re-run \`make vault-export\`."
	@echo "[vault-rotate] a db/redis password also needs the running server updated, or the next start still uses the old one."

# ---- Stack lifecycle --------------------------------------------------------
.PHONY: preflight
preflight: ## Drop containers whose network the daemon deleted, so up can recreate them
	uv run python scripts/dev/compose_preflight.py

.PHONY: up
up: preflight ## Start the full stack, rebuilding app images (requires Vault)
	# --build: `compose up` alone reuses the tagged image, so code merged since the
	# last build never reached the container.
	$(COMPOSE) up -d --build

.PHONY: rebuild
rebuild: preflight ## Rebuild the app tier and recreate it (gateway + worker only)
	# `up` rebuilds everything and needs Vault; a code change only needs the app
	# image, so this is the fast loop after a merge or a branch checkout.
	$(COMPOSE) build gateway worker
	$(COMPOSE) up -d --no-deps gateway worker

.PHONY: down
down: ## Stop the full stack
	$(COMPOSE) down

.PHONY: logs
logs: ## Tail logs for all services
	$(COMPOSE) logs -f

# ---- Dev data (snapshots before a destructive reset) ------------------------
.PHONY: backup
backup: ## Snapshot Postgres, the MinIO audit witness and the Keycloak realm
	uv run python scripts/dev/backup_dev.py backup

.PHONY: restore
restore: ## Load a snapshot: make restore BACKUP=.artifacts/backups/<UTC> [FORCE=1]
	@test -n "$(BACKUP)" || { echo "restore: BACKUP=<dir> is required" >&2; exit 2; }
	uv run python scripts/dev/backup_dev.py restore "$(BACKUP)" $(if $(FORCE),--force,)

# ---- Models -----------------------------------------------------------------
.PHONY: models
models: ## Fetch and verify the pinned ONNX guard graphs into ./models
	uv run python scripts/fetch_models.py

# ---- Tests ------------------------------------------------------------------
# Each target is the command README "Verification" documents, so the suite a
# reviewer runs and the one CI runs stay the same.
.PHONY: test
test: ## Unit tests: no database, no models, no network
	uv run pytest -m "not integration"

.PHONY: test-integration
test-integration: ## Database tests: starts a throwaway PostgreSQL 16, then removes it
	@set -euo pipefail; \
	name=bastion-test-db; port=55433; \
	trap 'docker rm -f "$$name" >/dev/null 2>&1 || true' EXIT INT TERM; \
	docker rm -f "$$name" >/dev/null 2>&1 || true; \
	docker run --rm -d --name "$$name" -p "$$port:5432" \
	  -e POSTGRES_USER=bastion -e POSTGRES_PASSWORD=bastion \
	  -e POSTGRES_DB=bastion_test postgres:16-alpine >/dev/null; \
	attempt=0; until docker exec "$$name" pg_isready -U bastion -d bastion_test >/dev/null 2>&1; do \
	  attempt=$$((attempt + 1)); [ $$attempt -lt 60 ] || { echo "test db did not become ready" >&2; exit 1; }; sleep 0.5; done; \
	TEST_DATABASE_URL="postgresql+asyncpg://bastion:bastion@localhost:$$port/bastion_test" \
	TEST_DATABASE_APP_URL="postgresql+asyncpg://bastion_app:bastion_app@localhost:$$port/bastion_test" \
	  uv run pytest -m integration

.PHONY: test-redis
test-redis: ## Redis tests: starts a throwaway Redis 7, then removes it
	@set -euo pipefail; \
	name=bastion-test-redis; port=56379; \
	trap 'docker rm -f "$$name" >/dev/null 2>&1 || true' EXIT INT TERM; \
	docker rm -f "$$name" >/dev/null 2>&1 || true; \
	docker run --rm -d --name "$$name" -p "$$port:6379" redis:7-alpine >/dev/null; \
	attempt=0; until docker exec "$$name" redis-cli ping >/dev/null 2>&1; do \
	  attempt=$$((attempt + 1)); [ $$attempt -lt 60 ] || { echo "test redis did not become ready" >&2; exit 1; }; sleep 0.2; done; \
	REDIS_TEST_URL="redis://localhost:$$port/0" uv run pytest -m redis_integration

.PHONY: test-witness
test-witness: ## Audit-witness tests (needs AUDIT_WITNESS_*)
	uv run pytest -m witness_integration

.PHONY: test-model
test-model: ## llama.cpp tests (needs LLAMA_CPP_BASE_URL)
	uv run pytest -m model_integration

.PHONY: test-evals
test-evals: ## Zero-tolerance golden eval gates (needs the ONNX models)
	uv run python scripts/run_evals.py
