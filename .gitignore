# --- Secrets: never commit ---------------------------------------------------
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling caches ----------------------------------------------------------
.mypy_cache/
.ruff_cache/
.pytest_cache/
.deepeval/
.coverage
coverage.xml
htmlcov/

# --- Local runtime artefacts -------------------------------------------------
*.log
models/*.gguf
models/*.bin
# ONNX repositories are downloaded per machine (hundreds of MB); only the
# directory marker is tracked.
models/*/
docker-compose.override.yml

# --- Evaluations -------------------------------------------------------------
.eval_reports/

# --- Evaluation reports -----------------------------------------------------
artifacts/evals/*
!artifacts/evals/.gitkeep

# --- Threat-intelligence reports --------------------------------------------
artifacts/threat-intel/*
!artifacts/threat-intel/.gitkeep

# --- Gate run logs -----------------------------------------------------------
artifacts/gate/*
!artifacts/gate/.gitkeep

# --- Compliance scan artifacts (SBOM, CVE reports) ---------------------------
artifacts/compliance/*
!artifacts/compliance/.gitkeep
