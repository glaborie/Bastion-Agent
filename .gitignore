# --- Secrets: never commit ---------------------------------------------------
.env
.env.*
!.env.example

# --- Trivy database cache restored by CI --------------------------------------
.cache/

# --- Generated certificate and key material (ADR-019, ADR-021) ----------------
# The CA root key, issued certificates, the compose secret files and the Vault
# dev TLS pair are generated per host by scripts/pki/bootstrap.sh and
# `make vault-up`; never commit them. scripts/check_secret_material.py fails the
# gate when any of this becomes trackable, so a fixture that must be committed
# goes in its allowlist with a justification rather than as a rule here.
pki/
secrets/
vault/certs/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Backlog index (rendered from backlog/items/) ----------------------------
# Generated by scripts/check_backlog.py --write. Tracked content is one file per
# item, so a branch never edits this index and two branches never conflict.
BACKLOG.md

# --- Tooling caches ----------------------------------------------------------
.mypy_cache/
.ruff_cache/
.pytest_cache/
.deepeval/
.coverage
coverage.xml
htmlcov/

# --- Local runtime artefacts -------------------------------------------------
*.log
models/*.gguf
models/*.bin
# ONNX repositories are downloaded per machine (hundreds of MB); only the
# directory marker is tracked.
models/*/
docker-compose.override.yml

# --- Evaluations -------------------------------------------------------------
.eval_reports/

# --- Evaluation reports -----------------------------------------------------
artifacts/evals/*
!artifacts/evals/.gitkeep

# --- Threat-intelligence reports --------------------------------------------
artifacts/threat-intel/*
!artifacts/threat-intel/.gitkeep

# --- Gate run logs -----------------------------------------------------------
artifacts/gate/*
!artifacts/gate/.gitkeep

# --- Compliance scan artifacts (SBOM, CVE reports) ---------------------------
artifacts/compliance/*
!artifacts/compliance/.gitkeep

# --- Falco runtime alerts ----------------------------------------------------
artifacts/falco/*
!artifacts/falco/.gitkeep

# --- Gitnexus graph DB -------------------------------------------------------
.gitnexus/
