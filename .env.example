# =============================================================================
# Bastion-Agent — local configuration template
# -----------------------------------------------------------------------------
# Copy to `.env` before running `docker compose up`.
#   cp .env.example .env
# Every value below is DEV-ONLY. Rotate all secrets before deploying anywhere
# beyond your workstation; the application refuses to start in `staging` or
# `production` while the development vault key / HMAC secret are still in place.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=bastion-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
GATEWAY_PORT=8000

# --- PostgreSQL 16 ----------------------------------------------------------
POSTGRES_USER=bastion
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=bastion
POSTGRES_PORT=5432
# Host-side URL (uv run / pytest). Containers receive their own URL from compose.
DATABASE_URL=postgresql+asyncpg://bastion:dev-only-postgres-password@localhost:5432/bastion
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_ECHO=false

# --- Redis 7 (ARQ queue + encrypted token vault) ----------------------------
REDIS_PASSWORD=dev-only-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:dev-only-redis-password@localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Keycloak (OIDC IdP) ----------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
KEYCLOAK_REALM=bastion
KEYCLOAK_CLIENT_ID=bastion-gateway
KEYCLOAK_AUDIENCE=bastion-gateway
KEYCLOAK_PORT=8080
# Public URL clients use to reach Keycloak. It becomes the token `iss` claim.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Issuer the gateway validates against (must equal the token `iss` claim).
KEYCLOAK_ISSUER=http://localhost:8080/realms/bastion
# JWKS is fetched over the internal network, independently of the public issuer.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/bastion/protocol/openid-connect/certs
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
KEYCLOAK_LEEWAY_SECONDS=30

# --- Secrets ----------------------------------------------------------------
# 32 raw bytes, base64 encoded (AES-256-GCM vault master key).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=YmFzdGlvbi1kZXYtaW5zZWN1cmUtdmF1bHQta2V5ISE=
VAULT_TTL_SECONDS=1800
# HMAC-SHA256 key for approval tickets.
APPROVAL_HMAC_SECRET=dev-only-approval-hmac-secret-change-me
APPROVAL_TTL_SECONDS=900

# --- Sensitivity classifier -------------------------------------------------
# Leave empty to use the deterministic semantic-rule fallback.
CLASSIFIER_MODEL_PATH=
CLASSIFIER_CONFIDENCE_THRESHOLD=0.55

# --- OmniRoute inference router ---------------------------------------------
# Locally built OmniRoute image. Override with the tag published in your environment.
OMNIROUTE_IMAGE=rigging/omniroute:3.8.52
OMNIROUTE_PORT=8001
OMNIROUTE_BASE_URL=http://localhost:20128
# Bearer token the gateway presents to OmniRoute (/v1 plane enforces API keys).
# Generated and stored here by scripts/omniroute_bootstrap.py; no need to invent one.
OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT_SECONDS=120
# Initial admin password for a freshly created OmniRoute data volume.
OMNIROUTE_ADMIN_PASSWORD=dev-only-omniroute-admin
MODEL_LOCAL_ALIAS=local-llama
MODEL_CLOUD_ALIAS=cloud-primary
# Cloud provider credential for the `cloud-primary` alias (register it in
# OmniRoute; see config/omniroute/config.yaml).
OPENROUTER_API_KEY=

# --- llama.cpp (local confidential inference, CUDA) -------------------------
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Place this GGUF file in ./models/ before starting the stack.
LLAMA_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=99
LLAMA_PORT=8002
# Bearer token enforced by llama.cpp and presented by the `local-llama` alias.
LLAMA_API_KEY=dev-only-llama-api-key
# Model id reported by llama.cpp's /v1/models (keep in sync with the OmniRoute alias).
LLAMA_MODEL_ALIAS=qwen2.5-7b-instruct-q4_k_m

# --- OpenTelemetry ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=bastion-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
DEPLOYMENT_ENV=local
# --- Langfuse ---------------------------------------------------------------
# Langfuse Cloud keys from Project Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# OTLP ingestion endpoint. Cloud regions: cloud (EU), us.cloud, jp.cloud, hipaa.cloud.
# Self-hosted: http://langfuse:3000/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Base64 of "<public_key>:<secret_key>", no surrounding quotes are needed:
#   python -c "import base64;print(base64.b64encode(b'pk-lf-...:sk-lf-...').decode())"
LANGFUSE_OTLP_AUTH=
# --- Arize AX ---------------------------------------------------------------
# Arize AX OTLP/HTTP endpoint (documented form includes /v1).
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Arize project the traces are routed into (x-project-name header).
ARIZE_PROJECT_NAME=bastion-agent
