# =============================================================================
# Bastion-Agent — local configuration template
# -----------------------------------------------------------------------------
# Copy to `.env` before running `docker compose up`.
#   cp .env.example .env
# Every value below is DEV-ONLY. Rotate all secrets before deploying anywhere
# beyond your workstation; the application refuses to start in `staging` or
# `production` while the development vault key / HMAC secret are still in place.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=bastion-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
GATEWAY_PORT=8000
# Addresses whose X-Forwarded-* headers Uvicorn trusts. Point this at your
# reverse proxy only; "*" would let any client spoof scheme/client IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- PostgreSQL 16 ----------------------------------------------------------
POSTGRES_USER=bastion
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=bastion
POSTGRES_PORT=5432
# Host-side URL (uv run / pytest). Containers receive their own URL from compose.
DATABASE_URL=postgresql+asyncpg://bastion:dev-only-postgres-password@localhost:5432/bastion
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_ECHO=false

# --- pgadmin ----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=pgadmin@gmail.com
PGADMIN_DEFAULT_PASSWORD=pgpassword

# --- Redis 7 (ARQ queue + encrypted token vault) ----------------------------
REDIS_PASSWORD=dev-only-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:dev-only-redis-password@localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Keycloak (OIDC IdP) ----------------------------------------------------
KEYCLOAK_ADMIN=admin
# Master-realm bootstrap administrator (http://localhost:8080/admin). This is
# NOT a `bastion`-realm dashboard login. The dashboard accounts (breakglass,
# alice, bob, carol, dave) are seeded by config/keycloak/realm-export.json and
# share the dev-only password `Bastion-dev-2026!`.
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
KEYCLOAK_REALM=bastion
KEYCLOAK_CLIENT_ID=bastion-gateway
# Must match the `bastion-gateway` client secret in
# config/keycloak/realm-export.json. DEV-ONLY: rotate before any real deployment.
KEYCLOAK_CLIENT_SECRET=dev-only-keycloak-client-secret
KEYCLOAK_AUDIENCE=bastion-gateway
KEYCLOAK_PORT=8080
# Public URL clients use to reach Keycloak. It becomes the token `iss` claim.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Issuer the gateway validates against (must equal the token `iss` claim).
KEYCLOAK_ISSUER=http://localhost:8080/realms/bastion
# JWKS is fetched over the internal network, independently of the public issuer.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/bastion/protocol/openid-connect/certs
# Back-channel token endpoint (containers use the internal service name).
KEYCLOAK_TOKEN_URI=http://keycloak:8080/realms/bastion/protocol/openid-connect/token
# Must be registered on the Keycloak client (realm-export.json).
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback
KEYCLOAK_SCOPES=openid profile email
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300
KEYCLOAK_JWKS_MIN_REFRESH_SECONDS=5
KEYCLOAK_LEEWAY_SECONDS=30
# Access-token claim carrying the tenant. The realm maps the `tenant` user
# attribute to this claim; a token without it is rejected (ADR-015).
TENANT_CLAIM=tenant_id
KEYCLOAK_HTTP_TIMEOUT_SECONDS=10

# --- Dashboard sessions (server-side in Redis) -----------------------------
SESSION_COOKIE_NAME=bastion_session
SESSION_TTL_SECONDS=28800
SESSION_REFRESH_LEEWAY_SECONDS=60
# Must be true outside local development (validated at startup).
SESSION_COOKIE_SECURE=false
LOGIN_STATE_TTL_SECONDS=600
# `/auth/logout` lands on a one-time page that ends the Keycloak SSO session;
# the marker forces `prompt=login` so a racing dashboard poll cannot silently
# re-authenticate.
LOGOUT_MARKER_COOKIE_NAME=bastion_logged_out
LOGOUT_MARKER_TTL_SECONDS=120
LOGOUT_TARGET_TTL_SECONDS=120
APPROVAL_PAGE_SIZE=100
AUDIT_PAGE_SIZE=50

# --- Per-principal rate limiting (ADR-013) ---------------------------------
# Redis token buckets keyed on the JWT subject, shared by every replica.
# Dashboard pages, HTMX partials and the polling APIs share one bucket; chat
# has its own. A limiter outage is 503, never unlimited. Rate limiting is on
# by default; set RATE_LIMIT_ENABLED=false only for a deliberate load test.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DASHBOARD_PER_WINDOW=60
RATE_LIMIT_CHAT_PER_WINDOW=120

# --- Evaluation reports ----------------------------------------------------
# JSON summary written by the DeepEval harness (Milestone 6).
EVAL_REPORT_PATH=artifacts/evals/latest.json

# --- Secrets ----------------------------------------------------------------
# 32 raw bytes, base64 encoded (AES-256-GCM vault master key).
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=YmFzdGlvbi1kZXYtaW5zZWN1cmUtdmF1bHQta2V5ISE=
VAULT_TTL_SECONDS=1800
# HMAC-SHA256 key for approval tickets.
APPROVAL_HMAC_SECRET=dev-only-approval-hmac-secret-change-me
APPROVAL_TTL_SECONDS=900
# HMAC-SHA256 key that signs identity-bearing worker jobs (ADR-018). The gateway
# and the demo CLI mint with it; the worker only verifies. Must differ from
# APPROVAL_HMAC_SECRET, and must be rotated before staging/production.
JOB_SIGNING_SECRET=dev-only-job-signing-secret-change-me
JOB_SIGNATURE_TTL_SECONDS=900

# --- Payload escrow (ADR-005, pre-production / debugging only) --------------
# When enabled, INPUT_RECEIVED also writes an AES-256-GCM copy of the exact
# payload it hashed, so a post-incident investigator can recover what the model
# saw. This is a PII store: leave it off outside a pre-production environment.
# ENVIRONMENT=production with this flag true refuses to start.
PAYLOAD_ESCROW_ENABLED=false
# Retention in seconds for escrow rows. Keep this far shorter than the ledger's
# retention (ADR-005 decision 5); the worker purges expired rows every 15 min.
PAYLOAD_ESCROW_TTL_SECONDS=86400
# Optional dedicated 32-byte base64 AES-256 key. Empty derives an HKDF-SHA256
# subkey from VAULT_MASTER_KEY, so no extra secret is required. Never commit a
# real key here.
PAYLOAD_ESCROW_MASTER_KEY=
# Maximum characters of the delivered answer covered by the RESPONSE_SENT hash
# and, when escrow is on, its encrypted copy. Longer answers are stored as a
# prefix with metadata truncated=true rather than growing the ledger unbounded.
RESPONSE_STORE_MAX_CHARS=32768

# --- Guarded tools (four-eyes execution) ------------------------------------
# ADR-009 Gate 1 allow-list; the gateway and worker refuse to start if it does
# not match the @tool registry. docs/ is copied into the image at /app/docs.
TOOL_CATALOG_PATH=docs/tools/v1.json
# Confined to the built-in file tools; created on demand with owner-only access.
TOOL_WORKSPACE_ROOT=/tmp/bastion-workspace
TOOL_MAX_READ_BYTES=262144
TOOL_MAX_WRITE_BYTES=1048576
TOOL_MAX_ARGUMENT_BYTES=1048576
# Enqueue approved tickets for immediate execution. The worker's
# resume_approved_tickets sweep is the safety net when this is false or Redis
# is unavailable, so approvals are never stranded.
TOOL_RESUME_AUTO_ENQUEUE=true
ARQ_CONNECTION_TIMEOUT_SECONDS=2
ARQ_QUEUE_NAME=bastion:jobs

# --- DLP (Presidio + reversible token vault) --------------------------------
# Presidio entity types. API_KEY, ADDRESS, DATE_OF_BIRTH and AHV_NUMBER are local
# recognizers for provider tokens, a street+postcode+place span, a labelled birth
# date and a Swiss AHV/AVS number with a valid EAN-13 check digit (756.1234.5678.97).
# Presidio's LOCATION and DATE_TIME are deliberately not used because they label
# "UDP", a GitHub token, "the board minutes" and "the opening hours" as PII.
DLP_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IBAN_CODE,IP_ADDRESS,CREDIT_CARD,US_SSN,API_KEY,ADDRESS,DATE_OF_BIRTH,AHV_NUMBER
DLP_SCORE_THRESHOLD=0.35
# The NER model is English-only (en_core_web_sm in the image). A prompt detected
# as another language still runs the language-independent pattern recognizers
# (EMAIL_ADDRESS, PHONE_NUMBER, IBAN_CODE, IP_ADDRESS, CREDIT_CARD, US_SSN,
# API_KEY), while the NER entities (PERSON, …) are skipped instead of misfiring
# on foreign words. Below this detector probability the text is analyzed as
# English, so short English prompts keep full NER coverage. Adding a language
# means adding its spaCy model to pyproject.toml and the image.
DLP_LANGUAGE_MIN_CONFIDENCE=0.80

# --- Egress sanitizer (ADR-012) ---------------------------------------------
# Marker embedded in system instructions and scanned for in model output. The
# session canary is created on first use and shares VAULT_TTL_SECONDS.
# Must be at least 8 characters: a shorter literal matches ordinary text, so
# inspect() would quarantine benign answers. Startup rejects it.
CANARY_PREFIX=BASTION-CANARY-
# Quarantine window after a canary leak, in seconds. There is deliberately no
# in-request override: a legitimate echo is indistinguishable from extraction.
EGRESS_TRIP_TTL_SECONDS=900

# --- Sensitivity classifier (ADR-011 two-model ensemble) ---------------------
# The production gate is two int8 ONNX graphs: an injection guard evaluated
# first, then a multi-label safety guard. Download them (once, ~400 MB total):
#
#   uvx --from huggingface_hub hf download \
#     Horizon-Labs/prompt-injection-guard-small \
#     --revision 2efc2ed5abecd21eb45c2506d231a65d6e392b85 \
#     --include 'onnx/model_quantized.onnx' tokenizer.json config.json \
#     --local-dir models/prompt-injection-guard-small
#   uvx --from huggingface_hub hf download \
#     onnx-community/content-safety-guard-small-ONNX \
#     --revision 74e953e4b14199e152899135cb176a0998135baf \
#     --include 'onnx/model_quantized.onnx' tokenizer.json config.json \
#     --local-dir models/content-safety-guard-small
#
# Leave both MODEL_PATH values empty to use the deterministic rule fallback.
# That fallback is only permitted with ENVIRONMENT=local; any other
# environment refuses to start without a model. docker-compose mounts ./models
# at /app/models, so these repo-relative paths work on the host and in the
# container alike.
CLASSIFIER_INJECTION_MODEL_PATH=models/prompt-injection-guard-small/onnx/model_quantized.onnx
CLASSIFIER_INJECTION_TOKENIZER_PATH=models/prompt-injection-guard-small/tokenizer.json
CLASSIFIER_SAFETY_MODEL_PATH=models/content-safety-guard-small/onnx/model_quantized.onnx
CLASSIFIER_SAFETY_TOKENIZER_PATH=models/content-safety-guard-small/tokenizer.json
# Per-inference token window. Long documents are scanned as overlapping
# windows and the maximum score wins, so an instruction planted late in a tool
# output is not missed.
CLASSIFIER_INJECTION_MAX_TOKENS=2048
CLASSIFIER_SAFETY_MAX_TOKENS=512
# production => 0.662; recall-first => 0.5 (more false alarms, more catches).
CLASSIFIER_INJECTION_PROFILE=production
# Explicit threshold override; leave empty to take the profile value.
CLASSIFIER_INJECTION_THRESHOLD=
# unsafe >= 0.5 flags for review; privacy, fraud_manipulation,
# criminal_planning and unauthorized_advice >= 0.3 route CONFIDENTIAL.
CLASSIFIER_SAFETY_UNSAFE_THRESHOLD=0.5
# The fp32 GPU graph is calibrated separately: it scores the benign
# prompt-engineering explainer 0.570 (int8: 0.364), so 0.5 would add a benign
# false positive. 0.6 keeps the fp-free operating point and the golden labels.
CLASSIFIER_SAFETY_UNSAFE_THRESHOLD_GPU=0.6
CLASSIFIER_SAFETY_CATEGORY_THRESHOLD=0.3
# Optional SHA-256 digests, measured from the revisions above. When set, startup
# refuses a graph whose bytes differ — an operator cannot silently swap a
# quantisation.
CLASSIFIER_INJECTION_MODEL_SHA256=61cd0741cdbfcc229e32e1de1392f352736d87d1e8b3c2b67ad9836bb7910d5d
CLASSIFIER_SAFETY_MODEL_SHA256=156b2b60eb1606d4f3c25913bb4dfc234b0be9b7bb85f29365cf29729f3ce2aa
# --- GPU graphs (ADR-011; optional, CUDA only) ------------------------------
# The int8 graphs above have no CUDA kernels for their quantised matmuls, so a
# CUDA session runs the fp32 graphs instead. Download them when the deployment
# uses the GPU image (docker-compose.gpu.yml):
#
#   uvx --from huggingface_hub hf download \
#     Horizon-Labs/prompt-injection-guard-small \
#     --revision 2efc2ed5abecd21eb45c2506d231a65d6e392b85 \
#     --include 'onnx/model.onnx' tokenizer.json config.json \
#     --local-dir models/prompt-injection-guard-small
#   uvx --from huggingface_hub hf download \
#     onnx-community/content-safety-guard-small-ONNX \
#     --revision 74e953e4b14199e152899135cb176a0998135baf \
#     --include 'onnx/model.onnx' tokenizer.json config.json \
#     --local-dir models/content-safety-guard-small
#
# Leave them empty to run the configured int8 graph on CUDA anyway: functional,
# but slower than the CPU path because the quantised matmuls stay on the CPU.
CLASSIFIER_INJECTION_MODEL_GPU_PATH=models/prompt-injection-guard-small/onnx/model.onnx
CLASSIFIER_SAFETY_MODEL_GPU_PATH=models/content-safety-guard-small/onnx/model.onnx
CLASSIFIER_INJECTION_MODEL_GPU_SHA256=e7aacffc0fe5b5a9362b2faea2c2aa7067d55ce88fb64b54a4dc2ec39e4523e7
CLASSIFIER_SAFETY_MODEL_GPU_SHA256=6de65550122a73493f5c3b5befcce95fd990ac63e05727d72dba7793502a4bf9
# Keep the deterministic rules as a floor while the ensemble is active. The
# safety model detects harmful content, not corporate secrecy, so without the
# floor "strictly confidential: board minutes" would route to the cloud. The
# floor can only add CONFIDENTIAL decisions, never remove one.
CLASSIFIER_RULES_FLOOR=true
# Execution provider for the two graphs: cpu | cuda | auto. CPU is the default
# because the shipped int8 graphs are faster there: MatMulInteger and
# DynamicQuantizeLinear have no CUDA kernel, so a GPU session shuttles tensors
# over PCIe to do the matmuls on the CPU anyway (ADR-011, measured 2026-11-10).
# A CUDA session uses the fp32 GPU graphs above, which do have CUDA kernels and
# measured p95 under 50 ms over the golden corpus on an RTX 3060 Ti
# (2026-11-11). cuda requires onnxruntime-gpu and refuses to start without it;
# the GPU image variant ships that wheel (docker-compose.gpu.yml).
CLASSIFIER_EXECUTION_PROVIDER=cpu
# Legacy single-graph contract: one model returning [PUBLIC, CONFIDENTIAL].
# Ignored when both ensemble model paths above are set.
CLASSIFIER_MODEL_PATH=
CLASSIFIER_TOKENIZER_PATH=
CLASSIFIER_MAX_TOKENS=512
CLASSIFIER_CONFIDENCE_THRESHOLD=0.55

# --- OmniRoute inference router ---------------------------------------------
# Locally built OmniRoute image. Override with the tag published in your environment.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.53@sha256:b52a17661a1aff42ffb78f349f423e986dfc55b57274f28559f8387622ef8ee4
OMNIROUTE_PORT=8001
OMNIROUTE_BASE_URL=http://localhost:8001
# Bearer token the gateway presents to OmniRoute (/v1 plane enforces API keys).
# Generated and stored here by scripts/omniroute_bootstrap.py; no need to invent one.
OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT_SECONDS=120
# Retries stay on the same alias; confidential traffic never falls back to cloud.
OMNIROUTE_MAX_RETRIES=1
OMNIROUTE_RETRY_BACKOFF_SECONDS=0.25
# Initial admin password for a freshly created OmniRoute data volume.
OMNIROUTE_ADMIN_PASSWORD=dev-only-omniroute-admin
MODEL_LOCAL_ALIAS=local-llama
MODEL_CLOUD_ALIAS=cloud-primary
# First target of each OmniRoute combo, router prefix removed. Reported as the
# requested model in traces so a span never claims an alias is a model id. They
# must match config/omniroute/config.yaml; tests/test_routing_client.py checks.
MODEL_LOCAL_PRIMARY=qwen2.5-7b-instruct-q4_k_m
MODEL_CLOUD_PRIMARY=openai/gpt-4o-mini
# Cloud provider credential for the `cloud-primary` alias (register it in
# OmniRoute; see config/omniroute/config.yaml).
OPENROUTER_API_KEY=

# --- llama.cpp (local confidential inference, CUDA) -------------------------
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Place this GGUF file in ./models/ before starting the stack.
LLAMA_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
LLAMA_CTX_SIZE=8192
LLAMA_N_GPU_LAYERS=99
LLAMA_PORT=8002
# Bearer token enforced by llama.cpp and presented by the `local-llama` alias.
LLAMA_API_KEY=dev-only-llama-api-key
# Model id reported by llama.cpp's /v1/models (keep in sync with the OmniRoute alias).
LLAMA_MODEL_ALIAS=qwen2.5-7b-instruct-q4_k_m

# --- OpenTelemetry ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=bastion-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
DEPLOYMENT_ENV=local
# Collector pipeline overlay. `otel-collector-no-export.yaml` keeps egress
# local (the default); `otel-collector-export.yaml` also fans out to Langfuse
# and Arize. Recreate the collector after changing it.
OTEL_REMOTE_EXPORT_CONFIG=otel-collector-no-export.yaml
# --- Langfuse ---------------------------------------------------------------
# Langfuse Cloud keys from Project Settings > API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# OTLP ingestion endpoint. Cloud regions: cloud (EU), us.cloud, jp.cloud, hipaa.cloud.
# Self-hosted: http://langfuse:3000/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Base64 of "<public_key>:<secret_key>", no surrounding quotes are needed:
#   python -c "import base64;print(base64.b64encode(b'pk-lf-...:sk-lf-...').decode())"
LANGFUSE_OTLP_AUTH=
# --- Arize AX ---------------------------------------------------------------
# OTLP/HTTP base endpoint. The collector appends /v1/traces, so do NOT put the
# /v1 signal path here: Arize answers 200 "ok" on /v1/v1/traces and silently
# drops the batch, which looks like a working export.
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Arize project the traces are routed into (x-project-name header).
ARIZE_PROJECT_NAME=bastion-agent
# --- Opik Cloud -------------------------------------------------------------
# Used only when OTEL_REMOTE_EXPORT_CONFIG=otel-collector-opik.yaml. Traces
# leave the host. The endpoint is the base URL: the collector appends
# /v1/traces, so do NOT add the signal path. The API key is sent verbatim in
# the Authorization header (no "Bearer " prefix); Comet-Workspace selects the
# workspace and projectName routes the spans into a project.
OPIK_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=bastion
